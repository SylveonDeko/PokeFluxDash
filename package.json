{
  "name": "pokeflux-dashboard",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "npm run generate-i18n && vite dev --host",
    "build": "npm run generate-i18n && vite build",
    "preview": "vite preview",
    "check": "npm run generate-i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "generate-i18n": "node generate-i18n.js",
    "check-i18n": "node generate-i18n.js --check",
    "check-fa-icons": "node validate-fa-icons.js"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.3.3",
    "@sveltejs/kit": "^2.45.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.14",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^24.7.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "colorthief": "^2.6.0",
    "crypto-js": "^4.2.0",
    "eslint": "^9.37.0",
    "eslint-plugin-svelte": "^3.12.4",
    "ioredis": "^5.8.1",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.39.9",
    "svelte-check": "^4.3.2",
    "tailwindcss": "^4.1.14",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  },
  "type": "module",
  "dependencies": {
    "@fontsource/opendyslexic": "^5.3.0",
    "@sentry/sveltekit": "^10.53.1",
    "nanoid": "^5.1.6",
    "svelte-persisted-store": "^0.12.0"
  }
}
