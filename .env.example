# PokeFlux dashboard environment. Copy to .env and fill in the values.
# Lines marked REQUIRED must be set for sign in and the bot API to work.

# ---------------------------------------------------------------- Fluxer OAuth
# Application (client) id of the Fluxer OAuth2 application. Also prefixes the Redis session keys. REQUIRED
FLUXER_CLIENT_ID=""
# Client secret of the same application, used for token exchange, refresh and revocation. REQUIRED
FLUXER_CLIENT_SECRET=""
# Where Fluxer sends users after sign in. Must match a redirect registered on the application. REQUIRED
FLUXER_REDIRECT_URI="http://localhost:5173/api/auth/callback"
# Space separated OAuth2 scopes requested at sign in.
FLUXER_SCOPES="identify"
# API URL of a self-hosted Fluxer instance, such as https://api.example.org. Leave empty for the main instance.
FLUXER_INSTANCE_URL=""
# Overrides for the REST API base and the sign in page. Taken from the instance when unset.
# FLUXER_API_URL="https://api.fluxer.app/v1"
# FLUXER_AUTHORIZE_URL="https://web.fluxer.app/oauth2/authorize"

# ---------------------------------------------------------------- Session cookies
# Random string of 32+ characters used to encrypt the token cookies. REQUIRED
COOKIE_ENCRYPTION_PASSWORD=""

# ---------------------------------------------------------------- Redis sessions
# Keep sessions in Redis. Without it the dashboard falls back to the encrypted cookies alone.
USE_REDIS=true
# Redis connection string.
REDIS_URL="redis://127.0.0.1:6379"

# ---------------------------------------------------------------- PokeFlux bot API
# Origin of the bot's HTTP API, without /api. REQUIRED
POKEFLUX_API_URL="http://localhost:5100"
# Sent as X-API-Key on every bot call. Must match the bot's ApiKey. REQUIRED
POKEFLUX_API_KEY=""
# HS256 secret for the per-request user token, 32+ characters. Must match the bot's JwtSecret. REQUIRED
BOT_JWT_SECRET=""
# Seconds a minted user token stays valid.
BOT_JWT_TTL="300"

# ---------------------------------------------------------------- Server
# Public origin of the dashboard. adapter-node needs it in production for form actions.
ORIGIN="https://pokeflux.tech"
NODE_ENV=production

# ---------------------------------------------------------------- Error tracking (optional)
# Sentry DSN, safe to expose to the browser.
PUBLIC_SENTRY_DSN=""
PUBLIC_SENTRY_ENVIRONMENT="production"
# Build time only: upload source maps when set.
# SENTRY_AUTH_TOKEN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""
